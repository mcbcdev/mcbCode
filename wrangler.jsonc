{
  "ai": {
    "binding": "AI"
  },
  "unsafe": {
    "bindings": [
      {
        "name": "MCP",
        "type": "service",
        "service": "mcp",
        "environment": "production"
      }
    ]
  },
  "kv_namespaces": [
    {
      "binding": "USAGE_KV",
      "id": "2870cfc9d57d45f3b7952e27856ba1a9"
    }
  ],
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "persist": true
    }
  },
  "name": "mcbcode",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./",
    "not_found_handling": "404-page"
  },
  "ratelimits": [
    { "name": "RL_ANON",        "namespace_id": "1001", "simple": { "limit": 60,  "period": 60 } },
    { "name": "RL_ANON_STRICT", "namespace_id": "1002", "simple": { "limit": 10,  "period": 60 } },
    { "name": "RL_USER",        "namespace_id": "1003", "simple": { "limit": 120, "period": 60 } },
    { "name": "RL_USER_STRICT", "namespace_id": "1004", "simple": { "limit": 30,  "period": 60 } }
  ]
}
